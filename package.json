{
  "name": "@runappsai/agent",
  "version": "0.1.2",
  "type": "module",
  "description": "Agent harness: the model ↔ tool loop with a workspace, skills, sessions, compaction, a sandbox and a chat UI. Bring any OpenAI-compatible model provider (RunApps included); no runtime dependencies.",
  "license": "MIT",
  "author": "RunApps",
  "homepage": "https://github.com/runapps/agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runapps/agent.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/agent.umd.js",
  "jsdelivr": "./dist/agent.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./browser": "./dist/agent.umd.js",
    "./browser/core": "./dist/agent-core.umd.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsup",
    "test": "npm run build && node --test --test-timeout=20000 tests/*.test.mjs",
    "release:cdn": "bash scripts/publish-cdn.sh"
  },
  "devDependencies": {
    "@runappsai/sdk": "^0.17.0",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.0.0",
    "pdfjs-dist": "^5.7.284",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  },
  "sideEffects": false
}
